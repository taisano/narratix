# Supabase（ダッシュボード > Project Settings > API）
# 公開してよい値のみ。service_role キーはここに書かない（サーバー専用の環境変数で扱う）
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# OpenAI（サーバー専用。NEXT_PUBLIC_ を付けない。GitHub・チャットに出さない）
OPENAI_API_KEY=sk-xxxxxxxx
# 任意：モデルと考える深さを変える時だけ（既定は gpt-6-luna / low）
# OPENAI_MODEL_CONSULT=gpt-6-luna
# OPENAI_EFFORT_CONSULT=low

# フィードバックのメール通知（Resend。https://resend.com）。無ければ保存だけする
# RESEND_API_KEY=re_xxxxxxxx
# FEEDBACK_TO_EMAIL=受け取るメールアドレス
# FEEDBACK_FROM_EMAIL=（任意）送り元。独自ドメインを Resend で確認するまでは空のまま

# Stripe（課金。docs/pricing-plan.md 9章）。どれも値はチャットやリポジトリに出さない。Vercel の環境変数にだけ入れる
# 課金を始める時だけ入れる。無い間は料金表は「この料金なら使いたい」の記録だけで、課金の API は 503 を返す
# STRIPE_SECRET_KEY=sk_test_xxxxxxxx            # テストモードの秘密鍵（本番は sk_live_…。切り替えは最後）
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx          # Stripe のダッシュボードで /api/stripe/webhook を登録すると発行される
# SUPABASE_SERVICE_ROLE_KEY=xxxxxxxx            # Webhook がプランを書き換えるためだけに使う。画面側には絶対に出さない
# NEXT_PUBLIC_BILLING_ENABLED=1                 # 1 にすると、料金表のボタンが Stripe への申し込みに変わる（ビルド時に決まる）
# STRIPE_PRICE_IDS_JSON={"pro:USD:m1":"price_…", …}   # 本番の Price ID 18個（無ければ、コード内のテスト用の ID を使う）
# STRIPE_MANAGED_PAYMENTS=1                     # 1 にすると Managed Payments（Stripe が販売者・税を処理）を使う。既定は使わない。使うなら商品の税コードの設定が先
