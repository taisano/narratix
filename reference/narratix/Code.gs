accessTier: accessTier,
accessSource: accessSource,
isBeta: isBeta,
isTrial: isBeta,
isPro: isPro,
betaStartedAt: betaStartedAt ? betaStartedAt.toISOString() : '',
betaEmail: props.getProperty(NARRATIX_USER_PROP_KEYS.betaEmail) || '',
