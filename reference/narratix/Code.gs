function deleteProjectsFromSidebar(outputIds) {
var requestedIds = Array.isArray(outputIds) ? outputIds : [outputIds];
var normalizedIds = [];
var seen = {};
for (var i = 0; i < requestedIds.length; i++) {
var id = String(requestedIds[i] || '').trim();
if (!id) continue;
var key = norm_(id);
if (seen[key]) continue;
seen[key] = true;
normalizedIds.push(id);
}
var projects = getOutputList_();
var projectMap = {};
for (var j = 0; j < projects.length; j++) {
projectMap[norm_(projects[j].id)] = projects[j];
}
var deletable = [];
var deletedNames = [];
for (var k = 0; k < normalizedIds.length; k++) {
var target = projectMap[norm_(normalizedIds[k])];
if (!target) continue;
deletable.push(target.id);
deletedNames.push(target.name || target.id);
}
if (!deletable.length) {
return withSidebarStatus_(
getSidebarModelForOutput(CURRENT_OUTPUT_ID),
{ statusType: 'error', statusMessage: 'DeleteするProjectが見つかりません。' }
);
}
for (var d = 0; d < deletable.length; d++) {
deleteProjectArtifacts_(deletable[d]);
}
var remaining = getOutputList_();
if (!remaining.length) {
CURRENT_OUTPUT_ID = '';
PropertiesService.getScriptProperties().deleteProperty('CURRENT_OUTPUT_ID');
activatePreviewSheet_();
return withSidebarStatus_(
buildEmptySidebarModel_(),
{
statusType: 'success',
statusMessage: deletedNames.length + '件のProjectを削除しました。',
preferredShellView: 'HOME'
}
);
}
var currentStillExists = false;
for (var r = 0; r < remaining.length; r++) {
if (norm_(remaining[r].id) === norm_(CURRENT_OUTPUT_ID)) {
currentStillExists = true;
break;
}
}
var nextProjectId = currentStillExists ? CURRENT_OUTPUT_ID : remaining[0].id;
CURRENT_OUTPUT_ID = nextProjectId;
PropertiesService.getScriptProperties().setProperty('CURRENT_OUTPUT_ID', nextProjectId);
activatePreviewSheet_();
var nextViewId = readSetting_(nextProjectId, 'ALL', 'CURRENT_VIEW_ID') || 'View_0';
var model = withSidebarStatus_(
getSidebarModelForView(nextProjectId, nextViewId),
{
statusType: 'success',
statusMessage: deletedNames.length === 1
? deletedNames[0] + ' を削除しました。'
: deletedNames.length + '件のProjectを削除しました。'
}
);
model.preferredShellView = 'PROJECT_MGMT';
return model;
}
