sheet.getRange(INPUT_INSTRUCTION_ROW, 1, 1, evaluationHeaders.length).merge()
.setValue(instructionText)
.setBackground('#dce8f5')
.setFontColor('#1a3a5c')
.setFontSize(10)
.setWrapStrategy(SpreadsheetApp.WrapStrategy.WRAP);
sheet.setRowHeight(INPUT_INSTRUCTION_ROW, 64);
sheet.getRange(INPUT_HEADER_ROW, 1, 1, evaluationHeaders.length).setValues([evaluationHeaders])
.setBackground('#1a3a5c').setFontColor('#ffffff').setFontWeight('bold');
sheet.setColumnWidth(1, 180);
for (var eh = 2; eh <= 6; eh++) sheet.setColumnWidth(eh, 110);
return sheet;
}
if (String(dataSchemaType || '').toUpperCase() === 'DRIVER_BRIDGE') {
var driverHeaders = ['Label', 'Value'];
sheet.getRange(INPUT_INSTRUCTION_ROW, 1, 1, driverHeaders.length).merge()
.setValue(instructionText)
.setBackground('#dce8f5')
.setFontColor('#1a3a5c')
.setFontSize(10)
.setWrapStrategy(SpreadsheetApp.WrapStrategy.WRAP);
sheet.setRowHeight(INPUT_INSTRUCTION_ROW, 126);
sheet.getRange(INPUT_HEADER_ROW, 1, 1, driverHeaders.length).setValues([driverHeaders])
.setBackground('#1a3a5c').setFontColor('#ffffff').setFontWeight('bold');
sheet.setColumnWidth(1, 180);
sheet.setColumnWidth(2, 120);
return sheet;
}
if (String(dataSchemaType || '').toUpperCase() === 'BUBBLE') {
var bubbleHeaders = getDefaultHeadersForSchema_('BUBBLE');
sheet.getRange(INPUT_INSTRUCTION_ROW, 1, 1, bubbleHeaders.length).merge()
.setValue(instructionText)
.setBackground('#dce8f5')
.setFontColor('#1a3a5c')
.setFontSize(10)
.setWrapStrategy(SpreadsheetApp.WrapStrategy.WRAP);
sheet.setRowHeight(INPUT_INSTRUCTION_ROW, 86);
sheet.getRange(INPUT_HEADER_ROW, 1, 1, bubbleHeaders.length).setValues([bubbleHeaders])
.setBackground('#1a3a5c').setFontColor('#ffffff').setFontWeight('bold');
sheet.setColumnWidth(1, 180);
sheet.setColumnWidth(2, 120);
sheet.setColumnWidth(3, 120);
sheet.setColumnWidth(4, 130);
sheet.setColumnWidth(5, 140);
return sheet;
}
var NUM_DEFAULT_SERIES = 5;
var totalCols = 1 + NUM_DEFAULT_SERIES; // X_Axis + Series_1〜5
// Row 1: Instruction（全列マージ・薄青背景）
sheet.getRange(INPUT_INSTRUCTION_ROW, 1, 1, totalCols).merge()
.setValue(instructionText)
.setBackground('#dce8f5')
.setFontColor('#1a3a5c')
.setFontSize(10)
.setWrapStrategy(SpreadsheetApp.WrapStrategy.WRAP);
sheet.setRowHeight(INPUT_INSTRUCTION_ROW, 40);
// Row 2: Header（X_Axis + Series_1〜Series_5）
var defaultHeaders = ['X_Axis'];
for (var s = 1; s <= NUM_DEFAULT_SERIES; s++) {
defaultHeaders.push('Series_' + s);
}
sheet.getRange(INPUT_HEADER_ROW, 1, 1, totalCols).setValues([defaultHeaders])
.setBackground('#1a3a5c').setFontColor('#ffffff').setFontWeight('bold');
// 列幅: B列以降（Series列）だけautoResize、A列はデフォルト幅を維持
sheet.autoResizeColumns(2, NUM_DEFAULT_SERIES);
return sheet;
}
// DATA_SCHEMA_TYPEに応じた説明文を返す
function getInstructionText_(dataSchemaType, uiLanguage) {
var schema = dataSchemaType || 'MATRIX_TIME_SERIES';
var lang = normalizeUiLanguage_(uiLanguage);
if (schema === 'EVALUATION') {
return lang === 'EN'
? 'Data for evaluation charts\nUse the first column for item labels, and the next columns for metric values.\nNarratiX uses the same table to generate multiple views automatically.'
: '評価チャート用データ\n1列目に項目名、2列目以降に指標の値を入力します。\n同じ表から複数の見せ方を自動生成します。';
}
if (schema === 'MATRIX_TIME_SERIES') {
return lang === 'EN'
? 'Data for trend and comparison charts\nUse the first column for periods or categories, and the next columns for values.\nAdd rows or columns as needed.'
: '推移・比較チャート用データ\n1列目に期間またはカテゴリ、2列目以降に数値を入力します。\n行・列は必要に応じて追加できます。';
} else if (schema === 'BUBBLE') {
return lang === 'EN'
? 'Data for relationship charts\nUse the first column for item labels, and the next columns for measure values.\nWith X and Y values, NarratiX shows a Scatter chart. If a Size column is included, it can also show a Bubble chart.\nAlso, if you want to group labels by similar colors, please include that in the Group section as well.'
: '関係性チャート用データ\n1列目に項目名、2列目以降に指標の値を入力します。\nX値とY値があればScatter、Size列があればBubbleも表示します。\nまた、Labelを同系色でGroup化したい場合はGroupにも記載をしてください。';
} else if (schema === 'MEKKO') {
return lang === 'EN'
? 'Data for composition charts\nUse the first column for periods or categories, and the next columns for component values.\nThe same data is used to show size and share.'
: '構成チャート用データ\n1列目に期間またはカテゴリ、2列目以降に構成項目の値を入力します。\n同じデータからサイズと構成比を表示します。';
} else if (schema === 'DRIVER_BRIDGE') {
return lang === 'EN'
? 'Data for change driver charts\nEnter the start value, change drivers, and end value.\nUse positive values for increases and negative values for decreases.\n\nRules\nThe first row is treated as Start, and the last row as End.\nRows in between are treated as Drivers.\nThe End value can be left blank.'
: '増減要因データ\n最初の値、増減要因、最後の値を入力します。\n増加要因はプラス、減少要因はマイナスで入力します。\n\n入力ルール\n1行目はStart、最終行はEndとして自動認識します。\n途中の行はDriverとして扱います。\nEndの値は空欄でもOKです。';
}
return 'How to use: Fill in the table below. Row 2 is the header row. Data starts from Row 3.';
}
function updateInputInstructionForView_(outputId, viewId) {
var sheet = resolveDataSheet_(outputId);
if (!sheet) return;
var dataSchemaType = readSetting_(outputId, viewId, 'DATA_SCHEMA_TYPE') || getDefaultDataSchemaTypeForPurpose_(readSetting_(outputId, viewId, 'PURPOSE') || 'Trend');
var uiLanguage = getUiLanguage_(outputId, viewId);
var layout = detectSheetLayout_(sheet);
if (String(dataSchemaType).toUpperCase() === 'EVALUATION') {
var instructionWidth = Math.max(1, sheet.getLastColumn());
sheet.getRange(layout.headerRow - 1, 1, 1, instructionWidth).breakApart();
sheet.getRange(layout.headerRow - 1, 1, 1, instructionWidth).merge();
sheet.getRange(layout.headerRow - 1, 1).setValue(getInstructionText_(dataSchemaType, uiLanguage))
.setBackground('#dce8f5')
.setFontColor('#1a3a5c')
.setFontSize(10)
.setWrapStrategy(SpreadsheetApp.WrapStrategy.WRAP);
sheet.setRowHeight(layout.headerRow - 1, 64);
return;
}
var width = Math.max(1, sheet.getLastColumn());
sheet.getRange(layout.headerRow - 1, 1, 1, width).breakApart();
sheet.getRange(layout.headerRow - 1, 1, 1, width).merge();
sheet.getRange(layout.headerRow - 1, 1).setValue(getInstructionText_(dataSchemaType, uiLanguage))
.setBackground('#dce8f5')
.setFontColor('#1a3a5c')
.setFontSize(10)
.setWrapStrategy(SpreadsheetApp.WrapStrategy.WRAP);
if (String(dataSchemaType).toUpperCase() === 'DRIVER_BRIDGE') {
sheet.setRowHeight(layout.headerRow - 1, 126);
} else if (String(dataSchemaType).toUpperCase() === 'BUBBLE') {
sheet.setRowHeight(layout.headerRow - 1, 86);
}
}
function isInputSheetDataEmpty_(sheet, layout) {
if (!sheet || !layout) return true;
var lastRow = sheet.getLastRow();
var lastCol = sheet.getLastColumn();
if (lastRow < layout.dataStartRow || lastCol < 1) return true;
var dataCount = lastRow - layout.dataStartRow + 1;
var values = sheet.getRange(layout.dataStartRow, 1, dataCount, lastCol).getDisplayValues();
for (var ri = 0; ri < values.length; ri++) {
for (var ci = 0; ci < values[ri].length; ci++) {
if (String(values[ri][ci] || '').trim() !== '') return false;
}
}
return true;
}
function syncInputSheetSchemaForView_(outputId, viewId, forceHeaders) {
var sheet = resolveDataSheet_(outputId);
if (!sheet) return;
var schema = readSetting_(outputId, viewId, 'DATA_SCHEMA_TYPE') || getDefaultDataSchemaTypeForPurpose_(readSetting_(outputId, viewId, 'PURPOSE') || 'Trend');
var lang = getUiLanguage_(outputId, viewId);
var layout = detectSheetLayout_(sheet);
if (String(schema).toUpperCase() === 'EVALUATION') {
var evalHeaders = getDefaultHeadersForSchema_(schema);
var evalWidth = Math.max(sheet.getLastColumn(), evalHeaders.length);
var canResetEvalHeaders = !!forceHeaders || isInputSheetDataEmpty_(sheet, layout);
sheet.getRange(layout.headerRow - 1, 1, 1, evalWidth).breakApart();
sheet.getRange(layout.headerRow - 1, 1, 1, evalWidth).merge();
sheet.getRange(layout.headerRow - 1, 1).setValue(getInstructionText_(schema, lang))
.setBackground('#dce8f5')
.setFontColor('#1a3a5c')
.setFontSize(10)
.setWrapStrategy(SpreadsheetApp.WrapStrategy.WRAP);
sheet.setRowHeight(layout.headerRow - 1, 64);
if (!canResetEvalHeaders) return;
sheet.getRange(layout.headerRow, 1, 1, evalWidth).clearContent();
sheet.getRange(layout.headerRow, 1, 1, evalHeaders.length).setValues([evalHeaders])
.setBackground('#1a3a5c').setFontColor('#ffffff').setFontWeight('bold');
sheet.setColumnWidth(1, 180);
for (var ec = 2; ec <= evalHeaders.length; ec++) sheet.setColumnWidth(ec, 110);
return;
}
var headers = getDefaultHeadersForSchema_(schema);
var canResetHeaders = !!forceHeaders || isInputSheetDataEmpty_(sheet, layout);
var width = Math.max(sheet.getLastColumn(), headers.length);
sheet.getRange(layout.headerRow - 1, 1, 1, Math.max(1, width)).breakApart();
sheet.getRange(layout.headerRow - 1, 1, 1, headers.length).merge();
sheet.getRange(layout.headerRow - 1, 1).setValue(getInstructionText_(schema, lang))
.setBackground('#dce8f5')
.setFontColor('#1a3a5c')
.setFontSize(10)
.setWrapStrategy(SpreadsheetApp.WrapStrategy.WRAP);
if (String(schema).toUpperCase() === 'DRIVER_BRIDGE') {
sheet.setRowHeight(layout.headerRow - 1, 126);
} else if (String(schema).toUpperCase() === 'BUBBLE') {
sheet.setRowHeight(layout.headerRow - 1, 86);
} else {
sheet.setRowHeight(layout.headerRow - 1, 40);
}
if (!canResetHeaders) return;
sheet.getRange(layout.headerRow, 1, 1, Math.max(width, headers.length)).clearContent();
sheet.getRange(layout.headerRow, 1, 1, headers.length).setValues([headers])
.setBackground('#1a3a5c').setFontColor('#ffffff').setFontWeight('bold');
if (String(schema).toUpperCase() === 'DRIVER_BRIDGE') {
sheet.setColumnWidth(1, 180);
sheet.setColumnWidth(2, 120);
} else if (String(schema).toUpperCase() === 'BUBBLE') {
sheet.setColumnWidth(1, 180);
sheet.setColumnWidth(2, 120);
sheet.setColumnWidth(3, 120);
sheet.setColumnWidth(4, 130);
sheet.setColumnWidth(5, 140);
} else {
sheet.autoResizeColumns(2, Math.max(headers.length - 1, 1));
}
}
