if (ids.length === 0) ids = ['View_0'];
var currentId = readSetting_(CURRENT_OUTPUT_ID, 'ALL', 'CURRENT_VIEW_ID') || ids[0];
var cell = sheet.getRange(ROW_VIEW_LABEL, 3);
