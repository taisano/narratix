_restoreFocus_(sheet, savedHlSide, savedHlTarget);
if (s['FLIP'] === 'TRUE') {
sheet.getRange(ROW_FLIP, 3).setValue('入れ替える（列 → 横軸）');
} else {
sheet.getRange(ROW_FLIP, 3).setValue('このまま（行 → 横軸）');
}
var visibleX = s['X_ITEMS_VISIBLE']
? s['X_ITEMS_VISIBLE'].split(',').map(function(v){ return v.trim(); }) : [];
for (var i = ROW_FILTER_START; i < ROW_FILTER_START + 60; i++) {
var lbl = norm_(sheet.getRange(i, COL_ROW_LBL).getValue());
if (!lbl) break;
sheet.getRange(i, COL_ROW_CB).setValue(
visibleX.length === 0 || visibleX.map(function(x){ return norm_(x); }).indexOf(norm_(lbl)) >= 0
);
}
var visibleY = s['Y_SERIES_VISIBLE']
? s['Y_SERIES_VISIBLE'].split(',').map(function(v){ return v.trim(); }) : [];
for (var j = ROW_FILTER_START; j < ROW_FILTER_START + 60; j++) {
var slbl = norm_(sheet.getRange(j, COL_COL_LBL).getValue());
if (!slbl) break;
sheet.getRange(j, COL_COL_CB).setValue(visibleY.length === 0 || visibleY.indexOf(slbl) >= 0);
}
if (info) refreshChartsInternal_(sheet, info);
}
