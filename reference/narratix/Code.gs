betaLastSeenAt: betaLastSeenAt ? betaLastSeenAt.toISOString() : '',
betaFeedbackOptIn: props.getProperty(NARRATIX_USER_PROP_KEYS.betaFeedbackOptIn) === 'true',
allowedPurposes: isPro ? [] : (isBeta ? NARRATIX_BETA_ALLOWED_PURPOSES.slice() : []),
allowedChartEntries: isPro ? [] : (isBeta ? NARRATIX_BETA_ALLOWED_CHART_ENTRIES.slice() : []),
licensePlan: licensePlan,
licenseStatus: licenseStatus,
licenseExpiresAt: licenseExpiresAt ? licenseExpiresAt.toISOString() : '',
licenseLastValidatedAt: props.getProperty(NARRATIX_USER_PROP_KEYS.licenseLastValidatedAt) || '',
