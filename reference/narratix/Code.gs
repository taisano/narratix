// アクティブシートが開発シートなら先にPreviewへ移動
var active = ss.getActiveSheet().getName();
if (DEV_SHEET_NAMES_.indexOf(active) >= 0) {
var p = getPreviewSheet_();
if (p) ss.setActiveSheet(p);
}
var hidden = [];
DEV_SHEET_NAMES_.forEach(function(n) {
var s = ss.getSheetByName(n);
if (s && !s.isSheetHidden()) { try { s.hideSheet(); hidden.push(n); } catch(e) {} }
});
SpreadsheetApp.getUi().alert(
hidden.length ? 'Hidden: ' + hidden.join(', ') + '\n\nNarratiX menu → Show Developer Sheets to restore.'
: 'No developer sheets to hide.'
);
}
function showDeveloperSheets() {
var ss = SpreadsheetApp.getActiveSpreadsheet();
var shown = [];
DEV_SHEET_NAMES_.forEach(function(n) {
var s = ss.getSheetByName(n);
if (s && s.isSheetHidden()) { try { s.showSheet(); shown.push(n); } catch(e) {} }
