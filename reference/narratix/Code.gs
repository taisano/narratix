// ============================================================
// ⑦ openOutput
// ============================================================
function openOutput(outputId) {
var ss = SpreadsheetApp.getActiveSpreadsheet();
var listSheet = getOutputListSheet_();
var last = listSheet.getLastRow();
var found = false;
if (last >= 2) {
var data = listSheet.getRange(2, 1, last - 1, 1).getValues();
for (var i = 0; i < data.length; i++) {
if (norm_(data[i][0]) === String(outputId)) { found = true; break; }
}
}
if (!found) {
SpreadsheetApp.getUi().alert(outputId + ' は Output_List に存在しません。');
return;
}
var dataSheet = dataSheetName_(outputId);
if (!ss.getSheetByName(dataSheet)) {
SpreadsheetApp.getUi().alert(dataSheet + ' シートが見つかりません。');
return;
}
PropertiesService.getScriptProperties().setProperty('CURRENT_OUTPUT_ID', outputId);
CURRENT_OUTPUT_ID = outputId;
setupPreviewSheet();
}
function menuOpenOutput() {
var ui = SpreadsheetApp.getUi();
var listSheet = getOutputListSheet_();
var last = listSheet.getLastRow();
if (last < 2) {
ui.alert('Project がまだありません。先に「⑥ New Project を作成」を実行してください。');
return;
}
var data = listSheet.getRange(2, 1, last - 1, 2).getValues();
var lines = [];
var ids = [];
for (var i = 0; i < data.length; i++) {
var oid = norm_(data[i][0]);
var name = String(data[i][1]);
if (!oid) continue;
ids.push(oid);
lines.push((i + 1) + '. ' + oid + ' ' + name);
}
if (ids.length === 0) {
ui.alert('有効な Project が見つかりませんでした。');
return;
}
var resp = ui.prompt(
'Project を開く',
'開く Project の番号または ID を入力してください:\n\n' + lines.join('\n'),
ui.ButtonSet.OK_CANCEL
);
if (resp.getSelectedButton() !== ui.Button.OK) return;
var input = resp.getResponseText().trim();
var targetId = null;
var num = parseInt(input, 10);
if (!isNaN(num) && num >= 1 && num <= ids.length) {
targetId = ids[num - 1];
} else {
var upper = input.toUpperCase();
for (var j = 0; j < ids.length; j++) {
if (ids[j].toUpperCase() === upper) { targetId = ids[j]; break; }
}
}
if (!targetId) {
ui.alert('"' + input + '" に対応する Project が見つかりませんでした。');
return;
}
openOutput(targetId);
}
