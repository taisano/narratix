function buildExportChartDataTables_(exportContext) {
var rawTableData = (exportContext.mekkoConfig && exportContext.mekkoConfig.rows && exportContext.mekkoConfig.rows.length)
? buildMekkoChartDataTable_(exportContext.mekkoConfig)
: (exportContext.purpose === 'Contribution' && exportContext.driverContext && exportContext.driverContext.waterfallRows && exportContext.driverContext.waterfallRows.length)
? buildDriverChartDataTable_(exportContext.driverContext)
: exportContext.helperData;
var cleanedTable = formatExportChartDataTableValues_(removeTotalColumnFromChartDataTable_(rawTableData));
return {
excel: cleanedTable,
thinkcell: addThinkCellSpacerRowToChartDataTable_(cleanedTable)
