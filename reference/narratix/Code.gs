// ============================================================
// Core: refreshChartsInternal_（オーケストレーター）
// ============================================================
function refreshChartsInternal_(sheet, info) {
var xAxisName = info.headers[0];
var outputId = CURRENT_OUTPUT_ID;
var viewId = readSetting_(outputId, 'ALL', 'CURRENT_VIEW_ID') || 'View_0';
var checkedRows = readChecked_(sheet, COL_ROW_CB, COL_ROW_LBL);
var checkedCols = readChecked_(sheet, COL_COL_CB, COL_COL_LBL);
if (checkedRows.length === 0) { SpreadsheetApp.getUi().alert('行の絞り込みで1つ以上チェックしてください。'); return; }
if (checkedCols.length === 0) { SpreadsheetApp.getUi().alert('列の絞り込みで1つ以上チェックしてください。'); return; }
syncPreviewControlsToSetting_(sheet, outputId, viewId, xAxisName, checkedRows, checkedCols);
buildCalc(outputId, viewId);
var isFlipped = readSetting_(outputId, viewId, 'FLIP') === 'TRUE';
var helperData = buildHelperData_(info, isFlipped, checkedRows, checkedCols, xAxisName);
var purpose = normalizePurpose_(readSetting_(outputId, viewId, 'PURPOSE') || 'Trend');
var hlSettings = readHighlightSettings_(outputId, viewId);
if (purpose === 'Trend' && hlSettings.side !== 'NONE' && hlSettings.target) {
helperData = reorderHelperDataColumnsForHighlight_(helperData, hlSettings.target);
}
var mekkoConfig = buildMekkoConfigForSelection_(info, xAxisName, isFlipped, checkedRows, checkedCols);
var comparisonContext = buildComparisonContextFromHelper_(
helperData,
readSetting_(outputId, viewId, 'COMPARISON_TARGET') || readSetting_(outputId, viewId, 'VARIANCE_COMPARE_TARGET') || '',
readSetting_(outputId, viewId, 'COMPARISON_SORT') || DEFAULT_COMPARISON_SORT
);
var varianceContext = buildVarianceContextFromHelper_(
helperData,
readSetting_(outputId, viewId, 'VARIANCE_BASE_TARGET') || '',
comparisonContext.target,
readSetting_(outputId, viewId, 'VARIANCE_SORT') || DEFAULT_VARIANCE_SORT
);
writeSetting_(outputId, viewId, 'COMPARISON_TARGET', comparisonContext.target);
writeSetting_(outputId, viewId, 'COMPARISON_SORT', comparisonContext.sort);
writeSetting_(outputId, viewId, 'VARIANCE_BASE_TARGET', varianceContext.baseTarget);
writeSetting_(outputId, viewId, 'VARIANCE_COMPARE_TARGET', varianceContext.compareTarget);
writeSetting_(outputId, viewId, 'VARIANCE_SORT', varianceContext.sort);
writeHelperToPreview_(sheet, helperData);
SpreadsheetApp.flush();
renderPreview_(sheet, outputId, viewId, helperData, mekkoConfig, comparisonContext, varianceContext);
SpreadsheetApp.flush();
}
// ============================================================
// syncPreviewControlsToSetting_
// ============================================================
function syncPreviewControlsToSetting_(sheet, outputId, viewId, xAxisName, checkedRows, checkedCols) {
var flipVal = String(sheet.getRange(ROW_FLIP, 3).getValue() || '');
var isFlipped = flipVal.indexOf('入れ替える') >= 0;
var activeSide = getActiveFocusSide_(isFlipped);
var focusResult = normalizeFocusSelection_(sheet, activeSide);
updateFocusUI_(sheet, isFlipped, activeSide);
var showLine = sheet.getRange(ROW_CHART_TOGGLE, COL_CB_LINE).getValue() === true;
var showBar = sheet.getRange(ROW_CHART_TOGGLE, COL_CB_BAR).getValue() === true;
var showCol = sheet.getRange(ROW_CHART_TOGGLE, COL_CB_COL).getValue() === true;
var title = String(sheet.getRange(ROW_TITLE, 3).getValue() || '');
var subtitle = String(sheet.getRange(ROW_SUBTITLE, 3).getValue() || '');
var source = String(sheet.getRange(ROW_SOURCE_UNIT, 3).getValue() || '');
var unit = String(sheet.getRange(ROW_SOURCE_UNIT, 5).getValue() || '');
writeSetting_(outputId, viewId, 'X_AXIS', xAxisName);
writeSetting_(outputId, viewId, 'FLIP', isFlipped ? 'TRUE' : 'FALSE');
writeSetting_(outputId, viewId, 'X_ITEMS_VISIBLE', checkedRows.join(','));
writeSetting_(outputId, viewId, 'Y_SERIES_VISIBLE', checkedCols.join(','));
writeSetting_(outputId, viewId, 'CHART_LINE', showLine ? 'TRUE' : 'FALSE');
writeSetting_(outputId, viewId, 'CHART_BAR', showBar ? 'TRUE' : 'FALSE');
writeSetting_(outputId, viewId, 'CHART_COLUMN', showCol ? 'TRUE' : 'FALSE');
writeSetting_(outputId, viewId, 'TITLE', title);
writeSetting_(outputId, viewId, 'SUBTITLE', subtitle);
writeSetting_(outputId, viewId, 'SOURCE', source);
writeSetting_(outputId, viewId, 'UNIT', unit);
writeSetting_(outputId, viewId, 'COLOR_THEME', 'Blue');
writeSetting_(outputId, viewId, 'COLOR_MODE', 'Default');
writeSetting_(outputId, viewId, 'AXIS_ORIENTATION', isFlipped ? 'SWAPPED' : 'NORMAL');
writeHighlightSettings_(outputId, viewId, focusResult.side, focusResult.target);
}
// ============================================================
// renderPreview_
// ============================================================
function renderPreview_(sheet, outputId, viewId, helperData, mekkoConfig, comparisonContext, varianceContext, driverContext) {
var title = readSetting_(outputId, viewId, 'TITLE') || '';
var subtitle = readSetting_(outputId, viewId, 'SUBTITLE') || '';
var source = readSetting_(outputId, viewId, 'SOURCE') || '';
var unit = readSetting_(outputId, viewId, 'UNIT') || '';
var xAxisName = readSetting_(outputId, viewId, 'X_AXIS') || '';
var isFlipped = readSetting_(outputId, viewId, 'FLIP') === 'TRUE';
var purpose = normalizePurpose_(readSetting_(outputId, viewId, 'PURPOSE') || 'Trend');
var uiLanguage = getUiLanguage_(outputId, viewId);
var hlSettings = readHighlightSettings_(outputId, viewId);
var previewMode = 'EXPORT';
var previewCfg = getPreviewModeConfig_(previewMode);
if (purpose === 'Contribution' && !driverContext) {
driverContext = buildDriverContextFromInfo_(getDataInfo_(), {
sortMode: readSetting_(outputId, viewId, 'DRIVER_SORT') || DEFAULT_DRIVER_SORT,
showZeroValues: readSetting_(outputId, viewId, 'SHOW_ZERO_VALUES') || DEFAULT_SHOW_ZERO_VALUES,
showValueLabels: readSetting_(outputId, viewId, 'SHOW_VALUE_LABELS') || DEFAULT_SHOW_VALUE_LABELS,
showConnectors: readSetting_(outputId, viewId, 'SHOW_CONNECTORS') || DEFAULT_SHOW_CONNECTORS,
colorMode: readSetting_(outputId, viewId, 'DRIVER_COLOR_MODE') || DEFAULT_DRIVER_COLOR_MODE,
numberFormat: readSetting_(outputId, viewId, 'DRIVER_NUMBER_FORMAT') || DEFAULT_DRIVER_NUMBER_FORMAT,
gapMode: readSetting_(outputId, viewId, 'DRIVER_GAP_MODE') || DEFAULT_DRIVER_GAP_MODE,
gridlinesMode: readSetting_(outputId, viewId, 'GRIDLINES_MODE') || 'OFF',
startLabel: readSetting_(outputId, viewId, 'START_LABEL') || '',
endLabel: readSetting_(outputId, viewId, 'END_LABEL') || ''
});
}
var visibleXStr = readSetting_(outputId, viewId, 'X_ITEMS_VISIBLE') || '';
var visibleYStr = readSetting_(outputId, viewId, 'Y_SERIES_VISIBLE') || '';
var checkedRows = visibleXStr ? visibleXStr.split(',').map(function(v){ return v.trim(); }) : [];
var checkedCols = visibleYStr ? visibleYStr.split(',').map(function(v){ return v.trim(); }) : [];
if (!comparisonContext) {
comparisonContext = buildComparisonContextFromHelper_(
helperData,
readSetting_(outputId, viewId, 'COMPARISON_TARGET') || readSetting_(outputId, viewId, 'VARIANCE_COMPARE_TARGET') || '',
readSetting_(outputId, viewId, 'COMPARISON_SORT') || DEFAULT_COMPARISON_SORT
);
}
if (!varianceContext) {
varianceContext = buildVarianceContextFromHelper_(
helperData,
readSetting_(outputId, viewId, 'VARIANCE_BASE_TARGET') || '',
comparisonContext.target,
readSetting_(outputId, viewId, 'VARIANCE_SORT') || DEFAULT_VARIANCE_SORT
);
}
var seriesItems = purpose === 'Contribution'
? ((driverContext && driverContext.drivers) || []).map(function(row) { return row.label; })
: purpose === 'Comparison'
? ((comparisonContext && comparisonContext.visibleSeriesItems) || checkedCols)
: (purpose === 'Trend' && !isFlipped && helperData && helperData[0]
? helperData[0].slice(1).map(function(item) { return String(item || ''); })
: (isFlipped ? checkedRows : checkedCols));
var dataRange = getHelperRange_(sheet, helperData.length, helperData[0].length);
var enabledTypes = getEnabledChartTypesForPurpose_(outputId, viewId, purpose);
var blockTemplates = getPreviewChartBlocks_(previewMode).filter(function(block) {
return enabledTypes.indexOf(String(block.chartType || '').toUpperCase()) >= 0;
});
blockTemplates = orderChartBlocksForPurpose_(purpose, blockTemplates);
var enabledBlocks = [];
for (var bi = 0; bi < blockTemplates.length; bi++) {
enabledBlocks.push(blockTemplates[bi]);
}
var blocks = layoutPreviewBlocks_(previewMode, enabledBlocks);
clearPreviewDisplayArea_(sheet, previewCfg, blocks);
var displayTitle = title || (purpose === 'Contribution'
? getLocalizedText_(uiLanguage, 'Driver Bridge', 'Driver Bridge')
: (purpose === 'Comparison'
? getLocalizedText_(uiLanguage, 'Ranked comparison', 'ランキング比較')
: (purpose === 'Relationship'
? getLocalizedText_(uiLanguage, 'Relationship overview', '関係性の概要')
: (purpose === 'Evaluate'
? getLocalizedText_(uiLanguage, 'Performance evaluation', '評価の概要')
: (xAxisName + getLocalizedText_(uiLanguage, ' trend', ' 推移'))))));
sheet.getRange(TITLE_ROW, CHART_ANCHOR_COL, 1, previewCfg.titleSpan).merge()
.setValue(displayTitle)
.setFontSize(previewCfg.titleSize).setFontWeight('bold').setFontColor('#1a3a5c');
var block2 = '';
if (subtitle) block2 += subtitle;
if (source) block2 += (block2 ? '　' : '') + getLocalizedText_(uiLanguage, 'Source: ', '出典: ') + source;
if (unit) block2 += (block2 ? '　' : '') + '[' + unit + ']';
if (block2) {
sheet.getRange(SUBTITLE_SRC_ROW, CHART_ANCHOR_COL, 1, previewCfg.titleSpan).merge()
.setValue(block2)
.setFontSize(previewCfg.subtitleSize).setFontWeight('normal').setFontColor('#666666');
}
var visualOpts = {
previewMode: previewMode,
chartWidth: previewCfg.chartWidth,
chartHeight: previewCfg.chartHeight,
isFlipped: isFlipped,
axisFontSize: previewCfg.axisFontSize || 10,
legendFontSize: previewCfg.legendFontSize || 11,
gridlinesMode: previewCfg.gridlinesMode || readSetting_(outputId, viewId, 'GRIDLINES_MODE') || DEFAULT_GRIDLINES_MODE,
dataLabelsMode: previewCfg.dataLabelsMode || readSetting_(outputId, viewId, 'DATA_LABELS_MODE') || (purpose === 'Relationship' ? 'ALL' : DEFAULT_DATA_LABELS_MODE),
lineMarkers: previewCfg.lineMarkers || readSetting_(outputId, viewId, 'LINE_MARKERS') || DEFAULT_LINE_MARKERS,
mekkoLabelMode: readSetting_(outputId, viewId, 'MEKKO_LABEL_MODE') || DEFAULT_MEKKO_LABEL_MODE,
showDifferenceLabels: readSetting_(outputId, viewId, 'SHOW_DIFFERENCE_LABELS') || DEFAULT_SHOW_DIFFERENCE_LABELS,
legendPosition: previewCfg.legendPosition || readSetting_(outputId, viewId, 'LEGEND_POSITION') || DEFAULT_LEGEND_POSITION,
chartLabelSize: previewCfg.chartLabelSize || 9,
purpose: purpose,
uiLanguage: uiLanguage,
driverSort: readSetting_(outputId, viewId, 'DRIVER_SORT') || DEFAULT_DRIVER_SORT,
