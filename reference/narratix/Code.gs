function createBlankInputSheet_(ss, sheetName, dataSchemaType, uiLanguage) {
var sheet = ss.insertSheet(sheetName);
var instructionText = getInstructionText_(dataSchemaType, uiLanguage);
if (String(dataSchemaType || '').toUpperCase() === 'EVALUATION') {
