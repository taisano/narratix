}
function addThinkCellSpacerRowToChartDataTable_(tableData) {
if (!tableData || !tableData.length) return tableData;
var cloned = tableData.map(function(row) {
return Array.isArray(row) ? row.slice() : [row];
});
if (cloned.length <= 1) return cloned;
var blankRow = cloned[0].map(function() { return ''; });
cloned.splice(1, 0, blankRow);
return cloned;
}
function formatExportChartDataTableValues_(tableData) {
if (!tableData || !tableData.length) return tableData;
return tableData.map(function(row, rowIndex) {
var copied = Array.isArray(row) ? row.slice() : [row];
if (rowIndex === 0) return copied;
return copied.map(function(value, colIndex) {
if (colIndex === 0) return value;
return formatExportChartDataValue_(value);
});
});
}
function formatExportChartDataValue_(value) {
if (value === null || value === undefined || value === '') return '';
if (typeof value === 'number') {
return formatExportChartDataNumber_(value);
}
var raw = String(value).trim();
if (!raw) return '';
if (/^-?\d+(\.\d+)?$/.test(raw)) {
return formatExportChartDataNumber_(Number(raw));
}
return value;
}
function formatExportChartDataNumber_(num) {
if (!isFinite(num)) return '';
if (Math.abs(num - Math.round(num)) < 0.0000001) {
return String(Math.round(num));
}
return String(Math.round(num * 100) / 100).replace(/(\.\d*?[1-9])0+$|\.0+$/, '$1');
}
function removeTotalColumnFromChartDataTable_(tableData) {
if (!tableData || !tableData.length) return tableData;
var normalizedRows = tableData.filter(function(row, index) {
if (index === 0) return true;
return !isTotalHeader_(Array.isArray(row) ? row[0] : row);
});
var header = normalizedRows[0] || [];
var totalIndexes = [];
for (var hi = 0; hi < header.length; hi++) {
if (isTotalHeader_(header[hi])) totalIndexes.push(hi);
}
if (!totalIndexes.length) {
return normalizedRows.map(function(row) {
return Array.isArray(row) ? row.slice() : [row];
});
}
totalIndexes.sort(function(a, b) { return b - a; });
return normalizedRows.map(function(row) {
var copied = Array.isArray(row) ? row.slice() : [row];
for (var ti = 0; ti < totalIndexes.length; ti++) {
copied.splice(totalIndexes[ti], 1);
}
return copied;
});
}
function buildDriverChartDataTable_(driverContext) {
var ctx = driverContext || {};
var rows = Array.isArray(ctx.waterfallRows) ? ctx.waterfallRows : [];
var table = [['Label', 'Value']];
for (var i = 0; i < rows.length; i++) {
table.push([String(rows[i].label || ''), Number(rows[i].value || 0)]);
}
return table;
}
function buildMekkoChartDataTable_(config) {
var headers = ['Category', 'Total'];
var series = (config && config.series) || [];
var rows = (config && config.rows) || [];
var table = [headers];
for (var i = 0; i < series.length; i++) headers.push(series[i].label);
table[0] = headers;
for (var r = 0; r < rows.length; r++) {
var row = rows[r];
var values = [];
var total = Number(row.total);
if (!isFinite(total)) total = 0;
for (var c = 0; c < series.length; c++) {
var num = Number((row.values || [])[c] || 0);
values.push(num);
if (!isFinite(Number(row.total))) total += num;
}
table.push([row.label, total].concat(values));
}
return table;
}
