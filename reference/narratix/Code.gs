function _loadViewToUI_(sheet, viewId, info) {
var s = readViewSettings_(CURRENT_OUTPUT_ID, viewId);
sheet.getRange(ROW_TITLE, 3).setValue(s['TITLE'] || '');
sheet.getRange(ROW_SUBTITLE, 3).setValue(s['SUBTITLE'] || '');
sheet.getRange(ROW_SOURCE_UNIT, 3).setValue(s['SOURCE'] || '');
sheet.getRange(ROW_SOURCE_UNIT, 5).setValue(s['UNIT'] || '');
sheet.getRange(ROW_CHART_TOGGLE, COL_CB_LINE).setValue(s['CHART_LINE'] !== 'FALSE');
sheet.getRange(ROW_CHART_TOGGLE, COL_CB_BAR) .setValue(s['CHART_BAR'] !== 'FALSE');
sheet.getRange(ROW_CHART_TOGGLE, COL_CB_COL) .setValue(s['CHART_COLUMN'] !== 'FALSE');
