function duplicateView() {
var ss = SpreadsheetApp.getActiveSpreadsheet();
var sheet = getPreviewSheet_();
if (!sheet) {
SpreadsheetApp.getUi().alert('先に「② Preview画面を作成」を実行してください。'); return;
}
var existingIds = getViewIds_(CURRENT_OUTPUT_ID);
