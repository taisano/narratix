SpreadsheetApp.getUi().alert('MVPではVersionは最大' + MAX_VIEWS + '個までです。\n現在: ' + existingIds.join(', '));
return;
}
var nextNum = existingIds.length;
var newId = 'View_' + nextNum;
var currentId = readSetting_(CURRENT_OUTPUT_ID, 'ALL', 'CURRENT_VIEW_ID') || 'View_0';
var info = getDataInfo_();
if (info) refreshChartsInternal_(sheet, info);
var srcSettings = readViewSettings_(CURRENT_OUTPUT_ID, currentId);
for (var key in srcSettings) {
writeSetting_(CURRENT_OUTPUT_ID, newId, key, srcSettings[key]);
}
// v29: 新Version名を自動付番 "Version N"
var newVersionNum = nextNum + 1;
writeSetting_(CURRENT_OUTPUT_ID, newId, 'VIEW_NAME', 'Version ' + newVersionNum);
writeSetting_(CURRENT_OUTPUT_ID, 'ALL', 'CURRENT_VIEW_ID', newId);
_rebuildViewDropdown_(sheet);
sheet.getRange(ROW_VIEW_LABEL, 3).setValue(newId);
_loadViewToUI_(sheet, newId, info);
SpreadsheetApp.getUi().alert(
'Version ' + newVersionNum + ' を作成しました（' + currentId + ' の複製）。\n' +
'設定を変更して「③ Previewを更新」を押してください。'
);
}
