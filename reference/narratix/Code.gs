// ============================================================
function getDataInfo_() {
// v31: 旧シート名(Data_Input_OPxx)にも自動フォールバック
var sheet = resolveDataSheet_(CURRENT_OUTPUT_ID);
if (!sheet) {
SpreadsheetApp.getUi().alert(
'Data sheet not found for ' + CURRENT_OUTPUT_ID + '.\n' +
'Expected: Input_' + CURRENT_OUTPUT_ID + ' or Data_Input_' + CURRENT_OUTPUT_ID
);
return null;
}
var layout = detectSheetLayout_(sheet);
var lastRow = sheet.getLastRow(), lastCol = sheet.getLastColumn();
var currentViewId = readSetting_(CURRENT_OUTPUT_ID, 'ALL', 'CURRENT_VIEW_ID') || 'View_0';
var schemaType = String(readSetting_(CURRENT_OUTPUT_ID, currentViewId, 'DATA_SCHEMA_TYPE') || '').toUpperCase();
if (schemaType === 'DRIVER_BRIDGE') {
var driverHeaderWidth = Math.max(2, lastCol);
var rawDriverHeaderRow = sheet.getRange(layout.headerRow, 1, 1, driverHeaderWidth).getValues()[0];
var driverHeaders = [];
for (var dhi = 0; dhi < rawDriverHeaderRow.length; dhi++) {
var driverHeader = norm_(rawDriverHeaderRow[dhi]);
if (!driverHeader) break;
driverHeaders.push(driverHeader);
}
if (driverHeaders.length < 2) driverHeaders = getDefaultHeadersForSchema_('DRIVER_BRIDGE');
var driverRows = [];
var driverDataCount = Math.max(0, lastRow - layout.dataStartRow + 1);
if (driverDataCount > 0) {
var driverValues = sheet.getRange(layout.dataStartRow, 1, driverDataCount, driverHeaders.length).getValues();
for (var dri = 0; dri < driverValues.length; dri++) {
var hasAnyValue = driverValues[dri].some(function(cell) {
return !(cell === '' || cell === null || cell === undefined);
});
if (!hasAnyValue) continue;
driverRows.push(driverValues[dri].slice(0, driverHeaders.length));
}
}
return { headers: driverHeaders, dataRows: driverRows };
}
if (schemaType === 'EVALUATION') {
var rawEvalHeaderRow = sheet.getRange(layout.headerRow, 1, 1, Math.max(2, lastCol)).getValues()[0];
var evalHeaders = [];
for (var ehi = 0; ehi < rawEvalHeaderRow.length; ehi++) {
var evalHeader = norm_(rawEvalHeaderRow[ehi]);
if (!evalHeader) break;
evalHeaders.push(evalHeader);
}
if (evalHeaders.length < 2) {
SpreadsheetApp.getUi().alert('Evaluation data needs at least 1 item column and 1 metric column.');
return null;
}
var dataCountEval = Math.max(0, lastRow - layout.dataStartRow + 1);
var evaluationRows = [];
if (dataCountEval > 0) {
var evalValues = sheet.getRange(layout.dataStartRow, 1, dataCountEval, evalHeaders.length).getValues();
for (var eri = 0; eri < evalValues.length; eri++) {
if (!norm_(evalValues[eri][0])) continue;
evaluationRows.push(evalValues[eri].slice(0, evalHeaders.length));
}
}
if (!evaluationRows.length) {
SpreadsheetApp.getUi().alert('No evaluation data rows found. Please enter item data from row ' + layout.dataStartRow + '.');
return null;
}
return {
headers: evalHeaders,
dataRows: evaluationRows,
evaluationHeaders: evalHeaders,
evaluationRows: evaluationRows
};
}
if (lastRow < layout.dataStartRow || lastCol < 2) {
SpreadsheetApp.getUi().alert('Data needs at least 1 X-axis column and 1 series column.'); return null;
}
var headerRow = sheet.getRange(layout.headerRow, 1, 1, lastCol).getValues()[0];
var headers = headerRow.map(function(h){ return norm_(h); });
var dataCount = lastRow - layout.dataStartRow + 1;
if (dataCount <= 0) {
SpreadsheetApp.getUi().alert('No data rows found. Please enter data from row ' + layout.dataStartRow + '.'); return null;
}
var dataRows = sheet.getRange(layout.dataStartRow, 1, dataCount, lastCol).getValues();
return { headers: headers, dataRows: dataRows };
}
// v31: buildCalc — 旧/新レイアウト両対応
function buildCalc(outputId, viewId) {
// v31: 旧シート名フォールバック
var dataSheet = resolveDataSheet_(outputId);
if (!dataSheet) return;
var schemaType = String(readSetting_(outputId, viewId, 'DATA_SCHEMA_TYPE') || '').toUpperCase();
if (schemaType === 'DRIVER_BRIDGE' || schemaType === 'BUBBLE' || schemaType === 'EVALUATION') return;
var xAxisName = readSetting_(outputId, viewId, 'X_AXIS');
var visibleXStr = readSetting_(outputId, viewId, 'X_ITEMS_VISIBLE');
var visibleYStr = readSetting_(outputId, viewId, 'Y_SERIES_VISIBLE');
if (!xAxisName || !visibleXStr || !visibleYStr) return;
var visibleRows = visibleXStr.split(',').map(function(v){ return v.trim(); }).filter(Boolean);
var visibleCols = visibleYStr.split(',').map(function(v){ return v.trim(); }).filter(Boolean);
if (visibleRows.length < 2 && visibleCols.length < 2) return;
// 旧/新レイアウト自動判別
var layout = detectSheetLayout_(dataSheet);
var lastRow = dataSheet.getLastRow(), lastCol = dataSheet.getLastColumn();
