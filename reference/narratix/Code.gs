for (var i = 0; i < images.length; i++) {
try { images[i].remove(); } catch (err) {}
}
} catch (err2) {}
}
function insertPreviewImage_(sheet, blob, anchorRow, anchorCol, targetWidth, targetHeight) {
var safeBlob = blob;
try {
safeBlob = Utilities.newBlob(blob.getBytes(), blob.getContentType() || 'image/png', blob.getName() || 'mekko-preview.png');
} catch (err0) {}
Utilities.sleep(250);
var image = sheet.insertImage(safeBlob, anchorCol, anchorRow, 0, 0);
try { image.setWidth(targetWidth); } catch (err1) {}
try { image.setHeight(targetHeight); } catch (err2) {}
Utilities.sleep(500);
SpreadsheetApp.flush();
return image;
}
function syncPreviewImages_(sheet, pendingImages) {
if (!pendingImages || !pendingImages.length) return;
var existing = [];
try { existing = sheet.getImages() || []; } catch (err1) {}
for (var i = 0; i < pendingImages.length; i++) {
var pending = pendingImages[i];
var img = existing[i];
if (img) {
var replaced = false;
try {
if (typeof img.replace === 'function') {
img.replace(pending.blob);
replaced = true;
}
} catch (err2) {}
if (!replaced) {
try { img.remove(); } catch (err3) {}
img = insertPreviewImage_(sheet, pending.blob, pending.anchorRow, pending.anchorCol, pending.width, pending.height);
} else {
try { img.setAnchorCell(sheet.getRange(pending.anchorRow, pending.anchorCol)); } catch (err4) {}
try { img.setWidth(pending.width); } catch (err5) {}
try { img.setHeight(pending.height); } catch (err6) {}
}
} else {
insertPreviewImage_(sheet, pending.blob, pending.anchorRow, pending.anchorCol, pending.width, pending.height);
}
}
for (var j = pendingImages.length; j < existing.length; j++) {
try { existing[j].remove(); } catch (err7) {}
}
}
function resetPreviewImages_(sheet, pendingImages) {
if (!pendingImages || !pendingImages.length) {
removeAllImages_(sheet);
SpreadsheetApp.flush();
return;
}
removeAllImages_(sheet);
SpreadsheetApp.flush();
Utilities.sleep(250);
for (var i = 0; i < pendingImages.length; i++) {
insertPreviewImage_(sheet, pendingImages[i].blob, pendingImages[i].anchorRow, pendingImages[i].anchorCol, pendingImages[i].width, pendingImages[i].height);
SpreadsheetApp.flush();
Utilities.sleep(200);
}
}
function clearPreviewContent_(sheet) {
removeAllCharts_(sheet);
removeAllImages_(sheet);
sheet.clearContents();
sheet.clearFormats();
