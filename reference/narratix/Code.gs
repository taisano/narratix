function normalizeNarratiXLicenseStatus_(status) {
var raw = String(status || '').trim().toUpperCase();
if (!raw) return '';
if (raw === 'VALID') return NARRATIX_LICENSE_STATUS_ACTIVE;
if (raw === 'CANCELED' || raw === 'CANCELLED' || raw === 'EXPIRED') return NARRATIX_LICENSE_STATUS_INVALID;
return raw;
}
function normalizeNarratiXLicensePlan_(plan) {
var raw = String(plan || '').trim().toUpperCase();
if (!raw) return '';
if (raw === 'LIFETIME') return NARRATIX_LICENSE_PLAN_PERPETUAL;
if (raw === 'ONE_TIME') return NARRATIX_LICENSE_PLAN_PERPETUAL;
if (raw === 'MONTH') return NARRATIX_LICENSE_PLAN_MONTHLY;
return raw;
}
function parseNarratiXIsoDate_(value) {
if (!value) return null;
var parsed = new Date(value);
return isNaN(parsed.getTime()) ? null : parsed;
}
function normalizeNarratiXAccessSource_(source) {
var raw = String(source || '').trim().toLowerCase();
if (raw === NARRATIX_ACCESS_SOURCE_TEST_UNLOCK) return NARRATIX_ACCESS_SOURCE_TEST_UNLOCK;
if (raw === NARRATIX_ACCESS_SOURCE_CREEM_LICENSE) return NARRATIX_ACCESS_SOURCE_CREEM_LICENSE;
if (raw === NARRATIX_ACCESS_SOURCE_FREE_BETA) return NARRATIX_ACCESS_SOURCE_FREE_BETA;
return '';
}
function isValidNarratiXEmail_(email) {
return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(String(email || '').trim());
}
function buildNarratiXAccessState_() {
var props = getNarratiXUserProperties_();
var now = new Date();
var licenseStatus = normalizeNarratiXLicenseStatus_(props.getProperty(NARRATIX_USER_PROP_KEYS.licenseStatus));
var licensePlan = normalizeNarratiXLicensePlan_(props.getProperty(NARRATIX_USER_PROP_KEYS.licensePlan));
var licenseExpiresAt = parseNarratiXIsoDate_(props.getProperty(NARRATIX_USER_PROP_KEYS.licenseExpiresAt));
var betaStartedAt = parseNarratiXIsoDate_(props.getProperty(NARRATIX_USER_PROP_KEYS.betaStartedAt));
var betaTermsAcceptedAt = parseNarratiXIsoDate_(props.getProperty(NARRATIX_USER_PROP_KEYS.betaTermsAcceptedAt));
var betaLastSeenAt = parseNarratiXIsoDate_(props.getProperty(NARRATIX_USER_PROP_KEYS.betaLastSeenAt));
var hasLicenseKey = !!String(props.getProperty(NARRATIX_USER_PROP_KEYS.licenseKey) || '').trim();
var storedAccessSource = normalizeNarratiXAccessSource_(props.getProperty(NARRATIX_USER_PROP_KEYS.accessSource));
var isLicenseTimeValid = !licenseExpiresAt || licenseExpiresAt.getTime() > now.getTime();
var isPro = licenseStatus === NARRATIX_LICENSE_STATUS_ACTIVE && isLicenseTimeValid;
var isBeta = !isPro
&& String(props.getProperty(NARRATIX_USER_PROP_KEYS.betaStatus) || '').trim().toLowerCase() === NARRATIX_BETA_STATUS_ACTIVE
&& isValidNarratiXEmail_(props.getProperty(NARRATIX_USER_PROP_KEYS.betaEmail));
var accessTier = isPro ? 'pro' : isBeta ? 'beta' : 'none';
var accessSource = isPro
? (storedAccessSource === NARRATIX_ACCESS_SOURCE_TEST_UNLOCK ? NARRATIX_ACCESS_SOURCE_TEST_UNLOCK : NARRATIX_ACCESS_SOURCE_CREEM_LICENSE)
: isBeta
? NARRATIX_ACCESS_SOURCE_FREE_BETA
: '';
var status = 'NONE';
if (isPro) {
status = licensePlan === NARRATIX_LICENSE_PLAN_PERPETUAL ? 'PRO_PERPETUAL_ACTIVE' : 'PRO_MONTHLY_ACTIVE';
} else if (isBeta) {
status = 'BETA_ACTIVE';
} else if (hasLicenseKey && licenseStatus === NARRATIX_LICENSE_STATUS_REVOKED) {
status = 'LICENSE_REVOKED';
} else if (hasLicenseKey) {
status = 'LICENSE_INVALID';
}
